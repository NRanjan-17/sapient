# pkg-config metadata for the SAPIENT C library.
# Generated by scripts/install-capi.sh — @PREFIX@ and @VERSION@ are substituted there.
prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: sapient
Description: SAPIENT edge inference engine — on-device LLM, speech and vision
URL: https://github.com/openhorizon-labs/sapient
Version: @VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lsapient
Libs.private: @PRIVATE_LIBS@
