# CMake package config for the SAPIENT C library.
#
#   find_package(sapient REQUIRED)
#   target_link_libraries(my_app PRIVATE sapient::sapient)
#
# Generated by scripts/install-capi.sh — @PREFIX@/@VERSION@ substituted there.

set(SAPIENT_VERSION "@VERSION@")

get_filename_component(SAPIENT_PREFIX "@PREFIX@" ABSOLUTE)
set(SAPIENT_INCLUDE_DIRS "${SAPIENT_PREFIX}/include")

find_library(SAPIENT_LIBRARY NAMES sapient PATHS "${SAPIENT_PREFIX}/lib" NO_DEFAULT_PATH)

if(NOT SAPIENT_LIBRARY)
    set(sapient_FOUND FALSE)
    if(sapient_FIND_REQUIRED)
        message(FATAL_ERROR "sapient: libsapient not found under ${SAPIENT_PREFIX}/lib")
    endif()
    return()
endif()

if(NOT TARGET sapient::sapient)
    add_library(sapient::sapient UNKNOWN IMPORTED)
    set_target_properties(sapient::sapient PROPERTIES
        IMPORTED_LOCATION "${SAPIENT_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${SAPIENT_INCLUDE_DIRS}")

    # System libraries the Rust dependency graph pulls in. Needed when linking the
    # static archive; harmless for the shared library.
    if(APPLE)
        set_property(TARGET sapient::sapient APPEND PROPERTY INTERFACE_LINK_LIBRARIES
            "-framework CoreFoundation" "-framework SystemConfiguration"
            "-framework Security" "-framework Metal" "-framework QuartzCore"
            c++ iconv)
    elseif(UNIX)
        set_property(TARGET sapient::sapient APPEND PROPERTY INTERFACE_LINK_LIBRARIES
            pthread dl m)
    endif()
endif()

set(sapient_FOUND TRUE)
